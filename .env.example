# ---------------------------------------------------------------------------
# product_categorisation (+ _gr, _non_us, _uk) -> powerbidb.product_categorisation_us_ca_uk_it
#
#   cp .env.example .env
#
# .env holds secrets: never commit it. Exported environment variables take
# precedence over values in this file.
# ---------------------------------------------------------------------------

# --- MySQL (destination is fixed: powerbidb.product_categorisation_us_ca_uk_it)
DB_HOST=13.126.54.249
DB_PORT=3306
# Must be powerbidb; any other value is refused.
DB_NAME=powerbidb
# Needs SELECT on the four sources, SELECT/INSERT/UPDATE on the target and
# CREATE TEMPORARY TABLES.
DB_USER=powerbi_user
DB_PASSWORD=change-me
DB_CONNECT_TIMEOUT_SECONDS=30

# --- Merge rules -------------------------------------------------------------
# Marketplaces written to the target. Others in the sources (e.g. UAE in
# product_categorisation_non_us) are skipped.
SYNC_MARKETPLACES=US,CA,UK,IT,DE
# true: every product_categorisation (US) row is also written as a CA row,
# as the table has always been built. CA ASINs only in _non_us are added too.
CA_MIRRORS_US=true

# --- Files -------------------------------------------------------------------
# DATA_DIR=data
# LOG_DIR=logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
# Target backups (taken before every write) and validation reports are kept this long.
BACKUP_RETENTION_DAYS=30
